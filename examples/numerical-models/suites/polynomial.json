{
  "slug": "polynomial",
  "ets_suite": "polynomial_test_suite",
  "ets_source": "src/polynomial/tests/polynomial_tests.rs",
  "equivalence_test": "src/compare.rs::polynomial_equiv",
  "validators": [
    {
      "source": "python",
      "argv": [
        "python3",
        "python3/polynomial.py"
      ]
    },
    {
      "source": "rust",
      "bin": "polynomial"
    }
  ],
  "plots": [
    {
      "argv": [
        "python3",
        "python3/plot_polynomial.py"
      ]
    }
  ],
  "conventions": {
    "polynomial_order": "ascending power (constant term first)",
    "kinds": [
      "host_tutorial",
      "host_stress",
      "host_visualization",
      "ets",
      "property"
    ]
  },
  "bounds": {
    "ABS_F64": 1e-12,
    "ABS_F32": 1e-06,
    "SOLVE_RESIDUAL_TAU": 20.0,
    "ZOH_AD_TAU": 20.0,
    "TAU_KAPPA": 20.0,
    "QUANT_LSB": 0.00390625,
    "stiff_zoh_relative": 1e-08
  },
  "cases": [
    {
      "id": "polynomial.host.tutorial",
      "kind": "host_tutorial",
      "name": "Degree-4 evaluation, calculus, mul/div, degree-12 companion",
      "inputs": {
        "coeffs": [
          2.0,
          -3.0,
          4.0,
          1.0,
          0.0
        ],
        "x_real": 2.5,
        "z_complex": {
          "re": 1.0,
          "im": 2.0
        },
        "integral_c0": 5.0,
        "p1": [
          1.0,
          2.0
        ],
        "p2": [
          3.0,
          4.0
        ],
        "monic": [
          1.0,
          12.0,
          66.0,
          220.0,
          495.0,
          792.0,
          924.0,
          792.0,
          495.0,
          220.0,
          66.0,
          12.0,
          1.0
        ],
        "monic_degree": 12
      },
      "operations": [
        "horner_real",
        "horner_complex",
        "derivative",
        "integral",
        "mul_poly",
        "div_rem",
        "companion_matrix"
      ],
      "json_keys": [
        "P_REAL",
        "P_C_RE",
        "P_C_IM",
        "DERIV",
        "P_DERIV",
        "INTEG",
        "P_INTEG",
        "PROD",
        "QUOT",
        "REM",
        "COMPANION"
      ],
      "bound": {
        "abs": 1e-12
      }
    },
    {
      "id": "polynomial.host.clustered_horner",
      "kind": "host_stress",
      "name": "Clustered-root Horner (x-1)^8 (x-1.01)^8",
      "inputs": {
        "p": "(x - 1)^8 (x - 1.01)^8",
        "degree": 16,
        "sweep": {
          "start": 0.9,
          "stop": 1.1,
          "n": 128
        },
        "timed_x": 1.005,
        "iters": 10000
      },
      "operations": [
        "horner_sweep"
      ],
      "json_keys": [
        "CLUSTER_COEFFS",
        "CLUSTER_X",
        "CLUSTER_Y"
      ],
      "timings": [
        "horner"
      ],
      "bound": {
        "|py-rs|": "gamma(32) * p_tilde(|x|)"
      }
    },
    {
      "id": "polynomial.ets.evaluation",
      "kind": "ets",
      "name": "test_polynomial_evaluation",
      "inputs": {
        "p": [
          1.0,
          2.0,
          3.0
        ],
        "x": [
          0.0,
          2.0,
          -1.0
        ]
      },
      "expected": {
        "p(x)": [
          1.0,
          17.0,
          2.0
        ]
      },
      "bound": {
        "abs": 1e-12
      }
    },
    {
      "id": "polynomial.ets.complex_evaluation",
      "kind": "ets",
      "name": "test_polynomial_complex_evaluation",
      "inputs": {
        "p": [
          1.0,
          0.0,
          1.0
        ],
        "z": {
          "re": 0.0,
          "im": 1.0
        }
      },
      "expected": {
        "p(j)": {
          "re": 0.0,
          "im": 0.0
        }
      }
    },
    {
      "id": "polynomial.ets.arithmetic",
      "kind": "ets",
      "name": "test_polynomial_arithmetic",
      "inputs": {
        "p1": [
          1.0,
          2.0,
          3.0
        ],
        "p2": [
          4.0,
          5.0,
          6.0
        ]
      },
      "expected": {
        "sum": [
          5.0,
          7.0,
          9.0
        ],
        "diff": [
          3.0,
          3.0,
          3.0
        ],
        "neg": [
          -1.0,
          -2.0,
          -3.0
        ]
      }
    },
    {
      "id": "polynomial.ets.derivative",
      "kind": "ets",
      "name": "test_polynomial_derivative",
      "inputs": {
        "p": [
          5.0,
          3.0,
          4.0,
          2.0
        ]
      },
      "expected": {
        "dp": [
          3.0,
          8.0,
          6.0
        ]
      }
    },
    {
      "id": "polynomial.ets.integral",
      "kind": "ets",
      "name": "test_polynomial_integral",
      "inputs": {
        "p": [
          3.0,
          8.0,
          6.0,
          0.0
        ],
        "c0": 5.0
      },
      "expected": {
        "integ": [
          5.0,
          3.0,
          4.0,
          2.0
        ]
      }
    },
    {
      "id": "polynomial.ets.multiplication",
      "kind": "ets",
      "name": "test_polynomial_multiplication",
      "inputs": {
        "p1": [
          1.0,
          2.0
        ],
        "p2": [
          3.0,
          4.0
        ]
      },
      "expected": {
        "prod": [
          3.0,
          10.0,
          8.0
        ]
      }
    },
    {
      "id": "polynomial.ets.div_rem",
      "kind": "ets",
      "name": "test_polynomial_div_rem",
      "inputs": {
        "num": [
          3.0,
          10.0,
          8.0
        ],
        "den": [
          1.0,
          2.0
        ],
        "zero_den": [
          0.0,
          0.0
        ],
        "high": [
          1.0,
          0.0,
          1.0
        ]
      },
      "expected": {
        "quot": [
          3.0,
          4.0
        ],
        "rem": [
          0.0
        ],
        "zero_den": "DivisionError::ZeroLeadingCoefficient",
        "degree_mismatch": "DivisionError::DegreeMismatch"
      }
    },
    {
      "id": "polynomial.ets.companion",
      "kind": "ets",
      "name": "test_companion_matrix",
      "inputs": {
        "p": [
          -6.0,
          -5.0,
          1.0
        ]
      },
      "expected": {
        "C": [
          [
            0.0,
            6.0
          ],
          [
            1.0,
            5.0
          ]
        ]
      }
    },
    {
      "id": "polynomial.ets.cubic_quintic_bilinear",
      "kind": "ets",
      "name": "test_cubic_quintic_bilinear",
      "inputs": {
        "cubic": {
          "p0": 0.0,
          "p1": 1.0,
          "v0": 0.0,
          "v1": 0.0
        },
        "quintic": {
          "p0": 0.0,
          "p1": 1.0,
          "v0": 0.0,
          "v1": 0.0,
          "a0": 0.0,
          "a1": 0.0
        },
        "bilinear": {
          "p": [
            1.0,
            1.0
          ],
          "Ts": 2.0
        }
      },
      "expected": {
        "z_coeffs": [
          0.0,
          2.0
        ]
      }
    },
    {
      "id": "polynomial.ets.constructors_and_storage",
      "kind": "ets",
      "name": "test_polynomial_constructors_and_storage",
      "inputs": {
        "constant": 4.0,
        "line": {
          "a": 1.0,
          "b": 2.0
        },
        "from_fn": "c_i = i",
        "div_zero": {
          "num": [
            1.0,
            0.0
          ],
          "den": [
            0.0
          ]
        }
      }
    },
    {
      "id": "polynomial.ets.view",
      "kind": "ets",
      "name": "test_polynomial_view",
      "inputs": {
        "p": [
          1.0,
          2.0,
          3.0
        ],
        "x": 2.0,
        "mut_c0": 4.0
      },
      "expected": {
        "p(2)": 17.0,
        "p_mut(2)": 20.0
      }
    }
  ]
}
